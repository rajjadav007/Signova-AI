# ==============================================================================
# Signova AI - Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Application Configuration
APP_NAME="Signova AI"
APP_ENV=development
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000

# AI/ML Execution & Model Paths
MODEL_DEVICE=cpu
MODEL_PATH=models/checkpoints/

# Database (Optional - for future user/session history)
DATABASE_URL=

# Speech & External Language Services (Optional)
SARVAM_API_KEY=
